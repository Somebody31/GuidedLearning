# API
PORT=8787
CORS_ORIGIN=http://localhost:3000
AUTH_TOKEN=

# Live AI — OFF by default in docs; set true only with a key
USE_LIVE_AI=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Hard caps so demos cannot burn credits
LIVE_AI_MAX_OUTPUT_TOKENS=400
LIVE_AI_MAX_CALLS=8
# true = only generate when a lesson is opened (no bulk course gen)
LIVE_AI_LAZY_ONLY=true

# Data
DATA_STORE=memory
DATA_DIR=data

# Embeddings: mock | local | remote
# local = Qwen3-Embedding sidecar (default 0.6B — no 0.8B in series; sizes 0.6/4/8B)
EMBEDDING_MODE=local
EMBEDDING_LOCAL_URL=http://127.0.0.1:8790
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMS=1024
# remote (optional paid/hosted)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
