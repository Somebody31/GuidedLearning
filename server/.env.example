# S3-compatible object storage (Phase B1+)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=guidedlearning
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# Data mode for B0: memory (default) | postgres (later)
DATA_STORE=memory
