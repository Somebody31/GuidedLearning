# API
PORT=8787
CORS_ORIGIN=http://localhost:3000
AUTH_TOKEN=dev-local-token

# Postgres + pgvector (Phase B1+)
# DATABASE_URL=postgres://gl:gl@localhost:5432/guidedlearning

# DeepSeek V4 Flash 0731
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Qwen3 Embedding (provider-specific base URL)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding-8b
