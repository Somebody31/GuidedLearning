# API
PORT=8787
CORS_ORIGIN=http://localhost:3000
AUTH_TOKEN=

# Offline by default — no paid API calls
USE_LIVE_AI=false

# Data
DATA_STORE=memory
DATA_DIR=data

# Postgres (later)
# DATABASE_URL=postgres://gl:gl@localhost:5432/guidedlearning

# DeepSeek V4 Flash 0731 — only used if USE_LIVE_AI=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Qwen3 Embedding — only used if USE_LIVE_AI=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_DIMS=64

# S3 (later)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
