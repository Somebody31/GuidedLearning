# API
PORT=8787
CORS_ORIGIN=http://localhost:3000
AUTH_TOKEN=

# Live AI — OFF by default in docs; set true only with a key
USE_LIVE_AI=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Hard caps so demos cannot burn credits
LIVE_AI_MAX_OUTPUT_TOKENS=400
LIVE_AI_MAX_CALLS=8
# true = only generate when a lesson is opened (no bulk course gen)
LIVE_AI_LAZY_ONLY=true

# Data
DATA_STORE=memory
DATA_DIR=data

# Qwen3 embeddings — only if USE_LIVE_AI=true and both set (else mock)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_DIMS=64
