# API
PORT=8787
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
AUTH_TOKEN=

# Live AI — OFF by default. auto + USE_LIVE_AI=false stays mock (no CLI quota).
# auto + USE_LIVE_AI=true uses DeepSeek if keyed, else the first ready local CLI.
# Explicit grok / pi / opencode works without a GuidedLearning API key
# (those CLIs use their own login or a free hosted model).
USE_LIVE_AI=false
LLM_BACKEND=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GROK_BIN=grok
PI_BIN=pi
OPENCODE_BIN=opencode
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
# GROK_MODEL=
# PI_MODEL=
AGENT_TIMEOUT_MS=90000

# Copy a folder already on this machine into a code course (home/tmp only).
# Off in production unless you set this true.
ALLOW_LOCAL_PATH=true

# Hard caps so demos cannot burn credits
LIVE_AI_MAX_OUTPUT_TOKENS=400
LIVE_AI_MAX_CALLS=8
# true = only generate when a lesson is opened (no bulk course gen)
LIVE_AI_LAZY_ONLY=true

# Data
DATA_STORE=file
DATA_DIR=data

# Embeddings: mock | local | remote
# local = Qwen3-Embedding sidecar (default 0.6B — no 0.8B in series; sizes 0.6/4/8B)
EMBEDDING_MODE=local
EMBEDDING_LOCAL_URL=http://127.0.0.1:8790
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMS=1024
# remote (optional paid/hosted)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
